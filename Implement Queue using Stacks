import java.util.Stack;

class MyQueue {
    // Stack to handle incoming elements (push operations)
    private Stack<Integer> inStack;
    // Stack to handle outgoing elements (pop and peek operations)
    private Stack<Integer> outStack;

    public MyQueue() {
        inStack = new Stack<>();
        outStack = new Stack<>();
    }
    
    // Pushes element x to the back of the queue
    public void push(int x) {
        inStack.push(x);
    }
    
    // Removes the element from the front of the queue and returns it
    public int pop() {
        moveElementsIfNecessary();
        return outStack.pop();
    }
    
    // Returns the element at the front of the queue
    public int peek() {
        moveElementsIfNecessary();
        return outStack.peek();
    }
    
    // Returns true if the queue is empty, false otherwise
    public boolean empty() {
        return inStack.isEmpty() && outStack.isEmpty();
    }

    // Helper method to shift elements from inStack to outStack when needed
    private void moveElementsIfNecessary() {
        if (outStack.isEmpty()) {
            while (!inStack.isEmpty()) {
                outStack.push(inStack.pop());
            }
        }
    }
}
